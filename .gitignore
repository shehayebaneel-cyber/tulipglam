node_modules
dist
.env
.env.*
!.env.example
*.local

# local sqlite (dev only)
server/dev.db
server/dev.db-journal
server/prisma/dev.db
server/prisma/dev.db-journal

# runtime uploads (ephemeral)
server/uploads
_backups
.DS_Store
_design

# stray dev-server logs
web/vite.log
server/*.log

# local database backups — never commit customer data
backups/

# scratch scripts written during a session — never part of the repo
_tmp-*

# Generated image derivatives — rebuilt by `node web/scripts/image-build.mjs --write`.
# 39,692 files; the sources in web/public/products/ are the tracked truth.
web/public/i/
# Screenshot evidence for a working session, regenerated by web/scripts/shots.mjs
shots/

# Import review sheets — regenerated by each importer run. The manifest IS tracked:
# it is the shared baseline for "what has already had eyes on it".
import-review/*.png
import-review/*-changed.txt

TulipGlam-brands.xlsx
TulipGlam-brand-names.xlsx
products-shelves.json
reclassify-untagged.json

# Overnight working artefacts: reports, measurements, and a production dump.
# .night/backup/ holds a real pg_dump with customer names, phones and addresses —
# it must never be committed. See BACKUP.md.
.night/backup/
