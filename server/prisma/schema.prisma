// TulipGlam — data model
// Local dev uses SQLite (zero setup). To deploy: switch provider to
// "postgresql", set DATABASE_URL (+ DIRECT_URL for migrations), `prisma db push`.
// Kept portable on purpose: statuses/tags are Strings (no enums, no arrays),
// so the Postgres switch is clean.
//
// BUSINESS MODEL — no physical inventory. The owner sources to order, so there
// are NO stock counts. A product's sellability is a single `status` string:
//   active | hidden | unavailable | discontinued
// Availability is confirmed per-order after checkout (see Order.status).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled (runtime)
  directUrl = env("DIRECT_URL") // Neon direct (migrations / db push)
}

// ------------------------------------------------------------------ taxonomy
model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  blurb     String     @default("")
  glyph     String     @default("jar") // ProductGlyph kind: bottle|dropper|jar|tube|lipstick|compact|mist
  tint      String     @default("#f5e9f0") // soft bg used on category cards
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  parentId  Int?
  parent    Category?  @relation("Subcats", fields: [parentId], references: [id])
  children  Category[] @relation("Subcats")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Brand {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  blurb     String    @default("")
  featured  Boolean   @default(false)
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  // Owner's default for the whole brand: "" (none), "men", "women" or "unisex". A stated fact
  // about the brand, so it outranks the classifier's measured skew — 404 brands is a far
  // smaller job than 9,533 products, and getting "Axe" right settles all of its rows at once.
  // Never written to Product; it is a signal the classifier reads, so a per-product override
  // set by hand still wins.
  audience  String    @default("")
  products  Product[]
  createdAt DateTime  @default(now())
}

// ------------------------------------------------------------------ catalogue
model Product {
  id     Int    @id @default(autoincrement())
  slug   String @unique
  name   String
  sku    String @default("") // supplier reference, for re-ordering (not shown to customers)
  // Which supplier import owns this row: "dali" | "beesline" | "feel22" | "" (manual).
  // Each importer deletes and rebuilds only its own source. Brand is NOT a safe scope —
  // Feel22 is a retailer that carries Beesline as a vendor, so both imports would
  // otherwise claim the same brand's products and delete each other's work.
  source String @default("")

  // Who the product is for: "unisex" | "men" | "women".
  //
  // Deliberately a field rather than a 13th department, because men's product spans Fragrance,
  // Skincare, Deodorant, Hair and Bath & Body simultaneously — a Collistar men's moisturiser
  // has to appear under BOTH /category/skincare and /men. A department would force a choice.
  //
  // Defaults to unisex so nothing is mis-claimed before the classifier has been reviewed.
  // Importers must never overwrite a value set by hand (see audienceLocked).
  audience       String  @default("unisex")
  /**
   * Set when a human chose the audience. Importers and the classifier must leave these alone.
   */
  audienceLocked Boolean @default(false)
  status         String  @default("active") // active|hidden|unavailable|discontinued
  priceCents     Int // display/base price in USD cents
  saleCents      Int? // if set (< priceCents) product is on sale
  shortDesc      String  @default("")
  description    String  @default("")
  howToUse       String  @default("")
  ingredients    String  @default("")

  // merchandising
  glyph        String  @default("bottle") // fallback silhouette when no photo
  tint         String  @default("#f5e9f0") // image-bed background
  isBestSeller Boolean @default(false)
  isNewMode    String  @default("auto") // auto|always|never (New badge, like mundo)
  concerns     String  @default("") // comma tags: hydration,acne,brightening...
  attributes   String  @default("") // comma tags: vegan,clean,cruelty-free,mini,refillable

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    Int?
  brand      Brand?   @relation(fields: [brandId], references: [id])

  videoUrl String @default("") // optional product video (self-hosted mp4)

  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin list sorts/filters on all of these across ~10k rows. See
  // scripts/2026-07-30-admin-indexes.sql — additive, safe to run online.
  @@index([status])
  @@index([categoryId])
  @@index([brandId])
  @@index([source])
  @@index([priceCents])
  @@index([updatedAt])
  @@index([name])
  // /men and /women filter on this across every department
  @@index([audience])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

// Shades / sizes. type = "shade" (has hex swatch) | "size" (has label).
// A shade may carry its own photo (imageUrl) — real shade photography beats a flat
// hex blob, so the swatch renders the photo when present and falls back to hex.
model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       String  @default("shade") // shade|size
  label      String // "Rosewood", "50ml"
  sku        String  @default("") // supplier reference for this exact shade
  hex        String  @default("") // swatch colour, used when imageUrl is empty
  imageUrl   String  @default("") // per-shade photo; also becomes the hero image when picked
  priceCents Int? // optional override of base price
  available  Boolean @default(true)
  sortOrder  Int     @default(0)

  @@index([productId, sortOrder])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int      @default(5)
  title     String   @default("")
  text      String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// A server error, kept so the owner finds out before a customer tells them.
///
/// The express error handler answers `{"error":"Something went wrong."}` and logs to stdout.
/// Render's free tier keeps a short log window and nobody reads it, so in practice a 500 in
/// production is invisible until somebody complains. This is the record.
///
/// Deliberately NOT a full APM: no third-party service, no script on the public page, no
/// per-visitor identifiers. Just what broke, where, and how often.
model ErrorLog {
  id Int @id @default(autoincrement())

  /// Grouping key — method + route pattern + error name. Same key means "the same thing broke".
  fingerprint String

  method String
  path   String
  status Int    @default(500)

  message String
  /// First few frames. Enough to find the line, short enough not to bloat the table.
  stack   String @default("")

  /// How many times this fingerprint has been seen, and when. One row per distinct problem
  /// rather than one per occurrence — a loop erroring 4,000 times should not fill the table.
  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  /// Set when the owner has looked at it. Keeps the dashboard about what is NEW.
  resolvedAt DateTime?

  @@unique([fingerprint])
  @@index([lastSeen])
  @@index([resolvedAt])
}

/// An email the store intended to send.
///
/// SMTP is unconfigured, and the mailer's previous behaviour was to log "not-configured" and
/// drop the message. That is graceful but lossy: every order confirmation, every status update
/// and every welcome since launch is simply gone. This table is where they wait instead.
///
/// ── NOT EVERY MESSAGE SHOULD BE SENT LATE ──────────────────────────────────────────
///
/// An order confirmation arriving three weeks after the parcel is worse than never arriving —
/// it reads as a system that has just woken up and is not to be trusted with your address. A
/// password reset arriving after its token expired is actively confusing. So each row carries
/// its own `expiresAt`, and the flush skips anything past it. The launch announcement is the
/// one kind with no expiry: it is explicitly a "send when ready" message.
model OutboxEmail {
  id Int @id @default(autoincrement())

  to      String
  subject String
  /// The rendered message. Stored whole so a send months later does not depend on the template
  /// still existing, or on the order it described still looking the same.
  html    String

  /// order-confirmation | status-update | welcome | points-confirmed | password-reset | launch
  kind String

  /// After this, the message is stale and will never be sent. Null means it never goes stale.
  expiresAt DateTime?

  sentAt    DateTime?
  attempts  Int       @default(0)
  lastError String    @default("")

  /// Stops the same message being queued twice by a retried request or a replayed hook.
  dedupeKey String? @unique

  createdAt DateTime @default(now())

  @@index([sentAt, expiresAt])
  @@index([kind])
}

/// Somebody who left their email on the coming-soon page.
///
/// Not a Customer: they have no account, no password and no orders — they are an audience, and
/// conflating the two would put half-people in the customers table and break every count that
/// reads it. When one of them eventually registers, they exist in both, which is correct: one
/// row is "asked to be told", the other is "has an account".
model LaunchSignup {
  id Int @id @default(autoincrement())

  /// Stored lowercased and trimmed, and unique on that — so "A@b.com" and "a@b.com " are one
  /// person. The endpoint answers identically whether the row was created or already existed,
  /// so this is never an oracle for "is this address on the list".
  email String @unique

  /// Where it came from, so a second capture point later is distinguishable. "coming-soon" today.
  source String @default("coming-soon")

  /// Set when the launch announcement is actually sent to this address. Null means unsent, which
  /// is what makes the send resumable: SMTP is unconfigured, so the list will sit unsent for a
  /// while and the eventual send must be safe to run twice.
  notifiedAt DateTime?

  /// Set if they ask to come off the list. Kept as a row rather than deleted — a deleted row
  /// would be re-added by the next signup and start mailing them again.
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([notifiedAt])
}

// ------------------------------------------------------------------ customers
model Customer {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  passwordHash    String
  fullName        String
  phone           String           @default("")
  createdAt       DateTime         @default(now())
  addresses       Address[]
  orders          Order[]
  resets          PasswordReset[]
  /// Requests they made while signed in. Guests have none; see ProductRequest.
  productRequests ProductRequest[]
  loyalty         LoyaltyAccount?
}

/**
 * A single-use password-reset ticket.
 * Only the SHA-256 of the token is stored: a leaked database must not hand out working reset
 * links. `usedAt` is set instead of deleting the row, so a second click on the same link can
 * be told it has already been used rather than looking indistinguishable from an expired one.
 */
model PasswordReset {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model Address {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String   @default("")
  phone      String   @default("")
  area       String   @default("")
  city       String   @default("")
  address    String   @default("")
  isDefault  Boolean  @default(false)
}

// ------------------------------------------------------------------ orders
model Order {
  id            Int       @id @default(autoincrement())
  number        String    @unique // TG-XXXXXX, shown to customer
  status        String    @default("received")
  // customer
  customerId    Int?
  customer      Customer? @relation(fields: [customerId], references: [id])
  fullName      String
  phone         String
  whatsapp      String    @default("")
  email         String    @default("")
  // delivery
  area          String    @default("") // Lebanon governorate/area
  city          String    @default("")
  address       String    @default("")
  notes         String    @default("")
  // money (USD cents)
  subtotalCents Int
  discountCents Int       @default(0)
  giftCardCents Int       @default(0)
  couponCode    String    @default("")
  giftCardCode  String    @default("")
  deliveryCents Int       @default(0)
  totalCents    Int
  paymentMethod String    @default("cod")

  // `awaiting_customer` is the pivotal state in a source-to-order business: we could not
  // source something and are waiting on the shopper. These record which line is blocked,
  // what we asked, and since when, so the admin can show it and chase it.
  // Nullable / defaulted on purpose — additive and backwards-compatible.
  awaitingItemId Int?
  awaitingNote   String    @default("")
  awaitingSince  DateTime?

  /// When this order first reached `delivered`. Set once, at the status change.
  ///
  /// Loyalty needs "delivered more than 7 days ago" on every balance read, and without this
  /// column the only source is MIN(OrderEvent.createdAt) over a table with no indexes at all —
  /// a scan per read. Worse, `canTransition` allows from === to and the status endpoint writes
  /// an event unconditionally, so an admin re-saving "Delivered" adds a SECOND delivered event;
  /// taking the wrong row silently pushes the maturity window back.
  ///
  /// Written only when moving INTO `delivered` and never overwritten, so it survives re-saves.
  deliveredAt DateTime?

  /// The part of the discount that came from redeemed loyalty points, in cents.
  ///
  /// Deliberately NOT folded into `discountCents`, which belongs to coupons. A reversal has to
  /// know which portion of a discount was points in order to give the right number back, and a
  /// shared field makes that unanswerable the first time a coupon and a redemption touch the
  /// same order. That combination is disallowed — so if both are ever non-zero, that is a bug
  /// worth being able to see rather than one silently averaged away.
  pointsDiscountCents Int @default(0)

  items                 OrderItem[]
  events                OrderEvent[]
  loyaltyEntries        LoyaltyLedgerEntry[]
  loyaltyClaimDecisions LoyaltyClaimDecision[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([deliveredAt])
}

// ------------------------------------------------------------------ promotions
model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  type          String    @default("percent") // percent|fixed
  value         Int       @default(0) // percent (0-100) or fixed USD cents
  minOrderCents Int       @default(0)
  maxUses       Int? // null = unlimited
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model GiftCard {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  initialCents  Int
  balanceCents  Int
  recipientName String   @default("")
  senderName    String   @default("")
  message       String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id])
  // snapshot so the order is stable even if the product later changes
  name         String
  brandName    String   @default("")
  variantLabel String   @default("")
  glyph        String   @default("bottle")
  tint         String   @default("#f5e9f0")
  imageUrl     String   @default("")
  priceCents   Int
  qty          Int      @default(1)
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String   @default("")
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------ config
model Setting {
  key   String @id
  value String @default("")
}

// Lebanon delivery areas + fee (USD cents). Phase-2 UI, seeded now.
model DeliveryArea {
  id        Int     @id @default(autoincrement())
  name      String
  feeCents  Int     @default(300)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

// ════════════════════════════════════════════════════════════════════════════════════
//  LOYALTY — "TulipGlam Rewards"
//
//  Two tables, both additive. Nothing existing changes shape.
//
//  The ledger is APPEND-ONLY. A balance is the sum of its entries and is never written
//  directly; `LoyaltyAccount.balanceCached` is a cache that may lag, never the truth. This is
//  what makes a customer dispute answerable a year later and any bug reconstructable.
//
//  Statuses and types are Strings, not Prisma enums, matching the rest of this schema — order
//  and product statuses are Strings too, validated in application code (see src/status.ts).
//  Introducing enums for one model would split the convention in half.
// ════════════════════════════════════════════════════════════════════════════════════

model LoyaltyAccount {
  id Int @id @default(autoincrement())

  /// The canonical key: a Lebanese number in E.164, e.g. "+96181643633".
  ///
  /// Phone rather than email because this is cash on delivery in Lebanon — the phone is the one
  /// field every order already carries, it is how delivery is coordinated, and a meaningful
  /// share of checkout emails are fake. Only ever written through normaliseLebanesePhone()
  /// (src/loyalty/phone.ts); writing a raw string here is what splits one human into two
  /// accounts.
  phoneE164 String @unique

  /// Set when the account is linked to a login. Nullable because a COD customer can earn points
  /// without ever creating one. Unique so two accounts cannot claim the same login.
  customerId Int?      @unique
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Notifications only. Never an identity key — see phoneE164.
  email String @default("")

  /// Reserved. v1 requires a signed-in customer to redeem instead of a one-time code, because
  /// there is no SMS provider and SMTP is unconfigured, so no code could actually be delivered.
  /// Kept so adding SMS later does not need a migration.
  phoneVerifiedAt DateTime?

  /// MONTH ONLY, 1-12. Deliberately not a full date of birth — the birthday bonus needs to know
  /// when, not how old, and storing less is the whole point.
  birthMonth Int?

  /// "petal" | "bloom" | "bouquet". Derived from trailing-12-month confirmed spend and cached
  /// here; the ledger remains the source of truth.
  tier         String   @default("petal")
  /// A tier is held 12 months from this moment. Demotion happens only at that anniversary.
  tierEarnedAt DateTime @default(now())

  /// Sum of confirmed, unexpired entries. A cache. Recomputed opportunistically on read.
  balanceCached Int @default(0)

  entries   LoyaltyLedgerEntry[]
  decisions LoyaltyClaimDecision[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([tier])
}

/// An admin's ruling on whether a past order belongs to a loyalty account.
///
/// The QUEUE itself is derived, not stored: a pending claim is simply a phone match with no row
/// here against it (see `pendingGuestClaims`). This table records only the DECISIONS, so there is
/// no second copy of "what is outstanding" to fall out of step with the orders it describes.
///
/// A rejection matters as much as an approval — without a row, a claim an admin has already
/// looked at and refused would reappear in the queue on every visit, and the fifth time it
/// appeared somebody would approve it just to make it go away.
model LoyaltyClaimDecision {
  id        Int            @id @default(autoincrement())
  accountId Int
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId   Int
  order     Order          @relation(fields: [orderId], references: [id])

  /// approved | rejected
  decision String

  /// Self-declared initials, exactly like `LoyaltyLedgerEntry.createdBy`. Admin access is one
  /// shared key with no per-admin identity, so this can only ever mean "someone holding the key".
  /// NOTHING MAY EVER TRUST IT FOR AUTHORISATION.
  decidedBy String @default("")

  /// Why. Required by the API, because a decision without a reason is unreviewable a year later.
  note String @default("")

  decidedAt DateTime @default(now())

  /// One ruling per (account, order). A second look is an edit, not a new row — and this is what
  /// makes a double-clicked Approve button grant once rather than twice.
  @@unique([accountId, orderId])
  @@index([accountId])
}

model LoyaltyLedgerEntry {
  id        Int            @id @default(autoincrement())
  accountId Int
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id])

  /// Idempotency guard: at most one `earn` entry per order, enforced by Postgres.
  ///
  /// Set to the order id on `earn` entries and left NULL on every other type. Postgres treats
  /// NULLs as distinct in a unique index, so the constraint binds only where it should — a
  /// replayed status change or a double-submit hits a unique violation instead of granting
  /// twice, while reversals and manual adjustments on the same order stay unrestricted.
  ///
  /// This duplicates `orderId` because Prisma cannot express a partial index
  /// (`... WHERE type = 'earn'`) in the schema, and an index created by hand in SQL would be
  /// dropped by the next `prisma db push`. The redundancy is the price of a guard that survives.
  earnOrderId Int? @unique

  /// The same guard, generalised, for every other write that must happen at most once.
  ///
  /// `earnOrderId` above covers earning. Everything else was a read-then-write — check whether a
  /// row exists, then insert if not — which grants twice under a double-click, a client retry or
  /// a replayed webhook, because both callers read before either wrote. Three of those were live:
  /// the sign-up bonus, the birthday bonus and the redemption reversal.
  ///
  /// Keys are namespaced strings, NULL on entries that have no once-only meaning:
  ///
  ///   signup:<accountId>                  the welcome bonus, once per account ever
  ///   birthday:<accountId>:<year>         once per calendar year
  ///   redemption-reversal:<orderId>       giving back points spent on a cancelled order
  ///   reversal:<orderId>:<portion>        clawing back a confirmed earn
  ///
  /// Postgres treats NULLs as distinct, so the constraint binds only on rows that set it.
  dedupeKey String? @unique

  /// earn | redeem | reversal | redemptionReversal | expiry | manualAdjustment
  type   String
  /// pending | confirmed | void
  ///
  /// A CACHE, not the truth. Spendability is computed at read time from the order's delivery
  /// date, because Render's free tier sleeps and no scheduled job can be relied on to have run.
  /// This column is materialised opportunistically so the data converges without a scheduler.
  status String @default("pending")

  /// SIGNED. Earning is positive, redemption and expiry negative. A balance may legitimately go
  /// negative after a reversal and must NOT be clamped: clamping would let someone redeem,
  /// return the goods, and keep the discount.
  points Int

  /// The tier multiplier in force when this entry was created, recorded so history stays
  /// explainable. Points earned at Petal are never retroactively re-multiplied.
  multiplierApplied Decimal @default(1.0) @db.Decimal(4, 2)

  /// Human-readable why. Mandatory for manual adjustments.
  reason    String @default("")
  /// Who made a manual adjustment. Admin auth is a single shared key with no per-admin identity,
  /// so today this can only record that someone holding that key did it.
  createdBy String @default("")

  confirmedAt DateTime?
  /// Confirmed points expire 12 months after the last account activity; any earn or redeem
  /// resets the clock. An `expiry` entry is always written — points never vanish silently.
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([accountId, status])
  @@index([accountId, expiresAt])
  @@index([orderId])
}

/// A customer asking for something the shop does not carry.
///
/// The business holds no inventory and sources every order, so "we don't have it" is never
/// the whole answer — it is the start of a conversation the shop can actually have. This is
/// where that conversation begins, and the most valuable place it appears is an empty search
/// result: the exact moment someone has proved they want something we do not list.
///
/// It is also a demand signal for the catalogue. Ten requests for one brand is a buying
/// decision the owner would otherwise never see.
model ProductRequest {
  id Int @id @default(autoincrement())

  /// What they are after, in their words. Never parsed, never matched against the catalogue —
  /// a request is a message to a person, not a query.
  wanted String

  /// Optional extra: a shade, a size, a link to the product elsewhere.
  note String @default("")

  /// How to reply. The shop runs on WhatsApp, so this is required at the form and stored E.164
  /// where it parses — the same normalisation the loyalty programme uses, so one person's
  /// requests and their orders can be recognised as the same person later.
  phone String

  /// Optional. Some people prefer it, and it costs nothing to accept.
  email String @default("")

  /// Set when a signed-in customer made the request, so their account can be found without
  /// matching on a phone number. Null for guests, which will be most of them.
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Where the request came from: "search" when it followed an empty search, "page" when they
  /// went looking for the form, "404" from a dead link. Tells the owner which entry point is
  /// actually earning requests rather than which one felt right to build.
  source String @default("page")

  /// The search term, when source is "search". The single most useful field here: it is a
  /// customer telling you, in their own words, what your catalogue is missing.
  searchTerm String @default("")

  /// open -> the owner has not dealt with it yet.
  /// sourced -> found and being listed or ordered.
  /// declined -> cannot or will not be supplied. Kept, not deleted: the reason a request was
  ///             declined is worth having when the same thing is asked for again.
  status String @default("open")

  /// The owner's own note. Never shown to the customer.
  adminNote String @default("")

  /// Set when it stops being open, so "how long are people waiting" is answerable.
  handledAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([phone])
}
