# TulipGlam — server environment.
# Copy to .env and fill in. .env is gitignored; this file is not.
# In production these live in Render → the service → Environment.

# ---- database (Neon Postgres, shared between localhost and production) ----
# Pooled URL:  ...-pooler...?sslmode=require&pgbouncer=true
DATABASE_URL=
# Direct URL (no -pooler): ...?sslmode=require
DIRECT_URL=

# ---- secrets ----
# Admin dashboard key. The server refuses to boot in production while this is the
# development default that ships in the repo.
ADMIN_KEY=
# Customer login token signing secret.
JWT_SECRET=

# ---- coming-soon gate (see LAUNCH.md) ----
# "true" puts the entire site behind web/public/coming-soon.html.
# Any other value — including unset — is off, and the gate is not even mounted.
COMING_SOON=false

# Lets one browser through the gate: visit /?preview=<this value>, and /?preview=exit to leave.
# Required ONLY while COMING_SOON=true; the server refuses to start if it is missing or shorter
# than 24 characters, because a guessable key is a public bypass of the whole gate.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PREVIEW_KEY=

# Optional: point the gate at a different HTML file. Defaults to web/dist/coming-soon.html,
# falling back to web/public/coming-soon.html. Used by the tests, and if the same gate is ever
# reused as a maintenance-mode page.
# COMING_SOON_PAGE=

# ---- optional ----
PORT=4230
# Email no-ops unless one of these is set — orders still work over WhatsApp.
# SMTP_URL=
# SMTP_HOST=
