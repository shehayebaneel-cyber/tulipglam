{
  "name": "tulipglam-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "import:dali": "node --env-file=.env --import tsx prisma/import-dali.ts",
    "import:beesline": "node --env-file=.env --import tsx prisma/import-beesline.ts",
    "import:feel22": "node --env-file=.env --import tsx prisma/import-feel22.ts",
    "db:push": "node --env-file=.env node_modules/prisma/build/index.js db push",
    "generate": "node --env-file=.env node_modules/prisma/build/index.js generate",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
